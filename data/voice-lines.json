[
{
"no": 1,
"cat": "1. 튜토리얼 (집)",
"who": "나 (학생 대답)",
"text": "안녕히 주무셨어요?",
"key": "va32d64df"
},
{
"no": 2,
"cat": "1. 튜토리얼 (집)",
"who": "나 (학생 대답)",
"text": "안녕히 주무세요.",
"key": "v80f983bc"
},
{
"no": 3,
"cat": "1. 튜토리얼 (집)",
"who": "나 (학생 대답)",
"text": "잘 가요!",
"key": "vfb67f8d0"
},
{
"no": 4,
"cat": "1. 튜토리얼 (집)",
"who": "나 (학생 대답)",
"text": "(아무 말 안 하기)",
"key": "v438ecd3c"
},
{
"no": 5,
"cat": "1. 튜토리얼 (집)",
"who": "나 (학생 대답)",
"text": "다녀오겠습니다!",
"key": "v087bf56f"
},
{
"no": 6,
"cat": "1. 튜토리얼 (집)",
"who": "나 (학생 대답)",
"text": "다녀왔습니다!",
"key": "v76491341"
},
{
"no": 7,
"cat": "1. 튜토리얼 (집)",
"who": "나 (학생 대답)",
"text": "(그냥 나가기)",
"key": "v06ddc29b"
},
{
"no": 8,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "여기는 우리 집이에요. 화면을 누르거나 방향키를 누르면 걸어가요.",
"key": "vca9313bc"
},
{
"no": 9,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "먼저 엄마한테 가 봐요. 노란 화살표가 있는 곳이에요.",
"key": "vdffcc778"
},
{
"no": 10,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "엄마에게 아침 인사를 해요.",
"key": "v9fe5f215"
},
{
"no": 11,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "급식카드는 먹을거리(체력 회복)에만 쓸 수 있어! 심부름 물건은 현금이나 체크카드로 내요.",
"key": "ve2dce112"
},
{
"no": 12,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "집을 나설 때는 뭐라고 인사할까?",
"key": "vfe2a82ad"
},
{
"no": 13,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "엄마가 용돈 2,000원을 현금으로 줬어요!",
"key": "vf6fccb89"
},
{
"no": 14,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "다녀왔습니다! 집 스테이지 완료!",
"key": "vf4da17a9"
},
{
"no": 15,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "배가 고플 땐 사 먹어요 이제 배가 고파서 체력이 없으면, 스테이지마다 한 번 상점에서 음식을 사 먹을 수 있어요.",
"key": "v43907d60"
},
{
"no": 16,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "카드를 꾹 누른 채로 끌어서 단말기에 대 보세요.",
"key": "v6681ecfa"
},
{
"no": 17,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "꿈이든 카드는 돈으로 쓸 수 없어! 꿈이든 카드는 나를 알려 주는 카드야.",
"key": "v80340708"
},
{
"no": 18,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "엄마에게 가 보세요.",
"key": "vfc2ce899"
},
{
"no": 19,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "배가 고플 땐 사 먹어요",
"key": "ve3d677c4"
},
{
"no": 20,
"cat": "1. 튜토리얼 (집)",
"who": "안내 (내레이션)",
"text": "이제 배가 고파서 체력이 없으면, 스테이지마다 한 번 상점에서 음식을 사 먹을 수 있어요.",
"key": "v04663d65"
},
{
"no": 21,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "일어났구나! 엄마한테 아침 인사 해 볼까?",
"key": "vb8ac328f"
},
{
"no": 22,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "그래! 오늘도 좋은 하루 보내자.",
"key": "ve16ae101"
},
{
"no": 23,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "화면 오른쪽 위를 봐. 내가 가진 돈이 나와 있어. 위에는 현금, 아래에는 계좌에 있는 돈이야.",
"key": "v07840a80"
},
{
"no": 24,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "세 번째 줄은 급식카드 잔액이야. 급식카드는 계좌와 다른 돈이야.",
"key": "vac08b3dc"
},
{
"no": 25,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "하트 아래 밥그릇 줄은 체력이야. 걷고 심부름하면 조금씩 줄어. 가만히 서서 10초쯤 쉴 때마다 조금씩 다시 차.",
"key": "vc8b9d2c2"
},
{
"no": 26,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "우리가 쓰는 돈을 하나씩 볼까? 누르면 이름을 말해 줘.",
"key": "vfd83b627"
},
{
"no": 27,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "이건 체크카드야. 카드 단말기에 한번 대 볼래?",
"key": "ve2748e7e"
},
{
"no": 28,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "어머, 결제가 안 되네! 계좌에 돈이 하나도 없거든.",
"key": "v983915c0"
},
{
"no": 29,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "체크카드는 현금이 아니야. 계좌에 들어 있는 돈만 쓸 수 있어. 계좌에 돈이 없으면 카드도 쓸 수 없어.",
"key": "vdd9f9f9f"
},
{
"no": 30,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "엄마가 계좌로 돈을 보내 줄게. 잘 봐!",
"key": "va9901cb4"
},
{
"no": 31,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "이제 계좌에 돈이 있으니까 카드로 낼 수 있어. 현금은 그대로지?",
"key": "v0f21b3c2"
},
{
"no": 32,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "이건 꿈이든 카드야. 이 카드로도 돈을 낼 수 있을까? 단말기에 대 봐.",
"key": "vc922b40c"
},
{
"no": 33,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "꿈이든 카드는 나를 알려 주는 카드야. 내 이름과 주소가 적혀 있어. 함께 읽어 볼까?",
"key": "v6b0f2a48"
},
{
"no": 34,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "밖에서 실수를 여러 번 하면, 잠깐 멈추고 꿈이든 카드를 보면서 내 이름과 주소를 확인할 거야. 확인하면 다시 할 수 있어.",
"key": "v731c1a2d"
},
{
"no": 35,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "이건 급식카드야. 스테이지를 시작할 때마다 저절로 돈이 채워져. 하지만 내가 먹을 것, 체력을 채우는 먹을거리에만 쓸 수 있어.",
"key": "v1a9aae94"
},
{
"no": 36,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "심부름이 끝나면 은행에 들러서 돈을 계좌에 넣을 수 있어. 천 원 단위로만 넣을 수 있단다.",
"key": "vd3ce7fb9"
},
{
"no": 37,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "계좌에 돈을 넣어 두면, 스테이지를 하나 끝낼 때마다 계좌에 있는 돈의 10%가 이자로 더 생겨.",
"key": "v22feeb9e"
},
{
"no": 38,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "게임 속 이자는 진짜 은행보다 훨씬 많아. 진짜 은행 이자는 아주 조금이야.",
"key": "v6036f612"
},
{
"no": 39,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "심부름 메모를 받으면 가게에 가서 물건을 사 오면 돼. 다 끝나면 오늘 한 일을 되돌아보고, 별과 도장을 받아.",
"key": "vcd76b4bd"
},
{
"no": 40,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "하루에 할 수 있는 스테이지 수가 정해져 있어. 천천히 하나씩 해 보자.",
"key": "v9306fd01"
},
{
"no": 41,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "잘 다녀와! 은행부터 들러 볼까?",
"key": "v54475a36"
},
{
"no": 42,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "잘 다녀왔어! 이제 하나씩 해 볼까?",
"key": "v17cc11ee"
},
{
"no": 43,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "초록 하트는 실수할 수 있는 기회야. 틀리면 하나씩 깨져. 2개가 다 깨지면 꿈이든 카드로 나를 확인하고, 그다음에 하트가 다시 가득 차.",
"key": "v953d5319"
},
{
"no": 44,
"cat": "1. 튜토리얼 (집)",
"who": "엄마",
"text": "초록 하트는 실수할 수 있는 기회야. 틀리면 하나씩 깨져. 3개가 다 깨지면 꿈이든 카드로 나를 확인하고, 그다음에 하트가 다시 가득 차.",
"key": "v61a935b8"
},
{
"no": 47,
"cat": "2. 엄마 (집)",
"who": "나 (학생 대답)",
"text": "(그냥 들어가기)",
"key": "v2368c7db"
},
{
"no": 48,
"cat": "2. 엄마 (집)",
"who": "안내 (내레이션)",
"text": "집에 돌아왔어요. 엄마에게 뭐라고 인사할까요?",
"key": "va8b41e03"
},
{
"no": 49,
"cat": "2. 엄마 (집)",
"who": "안내 (내레이션)",
"text": "집에 돌아왔어요. 뭐라고 인사할까요?",
"key": "v8dccf41f"
},
{
"no": 50,
"cat": "2. 엄마 (집)",
"who": "엄마",
"text": "준비 끝! 이제 현관으로 가 볼까?",
"key": "va67a9cb0"
},
{
"no": 51,
"cat": "2. 엄마 (집)",
"who": "엄마",
"text": "오늘은 여기까지! 내일 또 하자.",
"key": "vf9883bfa"
},
{
"no": 52,
"cat": "2. 엄마 (집)",
"who": "엄마",
"text": "오늘도 잘했어! 동네를 둘러봐도 좋아.",
"key": "vfca5c0f0"
},
{
"no": 53,
"cat": "2. 엄마 (집)",
"who": "엄마",
"text": "현관으로 가서 인사하고 학교에 가렴.",
"key": "v93a8e170"
},
{
"no": 54,
"cat": "2. 엄마 (집)",
"who": "엄마",
"text": "은행에 들렀다 오렴.",
"key": "vf47952f4"
},
{
"no": 55,
"cat": "2. 엄마 (집)",
"who": "엄마",
"text": "잘 다녀와!",
"key": "v7f81fa3e"
},
{
"no": 56,
"cat": "2. 엄마 (집)",
"who": "엄마",
"text": "하나 더 부탁해도 될까? 새 메모야.",
"key": "vd55bfda5"
},
{
"no": 57,
"cat": "2. 엄마 (집)",
"who": "엄마",
"text": "전통시장은 현금만 받는 가게가 많아. 현금으로 내렴.",
"key": "v1e44f998"
},
{
"no": 58,
"cat": "2. 엄마 (집)",
"who": "엄마",
"text": "마트에서는 입구에서 카트를 빼야 해. 카트에 100원짜리 동전을 넣으면 빠져. 다 쓰면 돌려받을 수 있어.",
"key": "veccef8b2"
},
{
"no": 59,
"cat": "2. 엄마 (집)",
"who": "엄마",
"text": "어서 와! 오늘도 혼자서 잘 다녀왔구나.",
"key": "v33a7f9f2"
},
{
"no": 70,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "가게 사람",
"text": "어서 와! 체육 도구를 빌리러 왔니?",
"key": "v6086441e"
},
{
"no": 71,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "가게 사람",
"text": "대여카드를 보여 줄래?",
"key": "v114c0544"
},
{
"no": 72,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "가게 사람",
"text": "다 쓰면 꼭 반납하러 와!",
"key": "v0fd9f570"
},
{
"no": 73,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "가게 사람",
"text": "반납하러 왔구나! 무엇을 빌렸었니?",
"key": "v2885b2af"
},
{
"no": 74,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "가게 사람",
"text": "반납 완료! 깨끗하게 잘 썼구나.",
"key": "v35ade304"
},
{
"no": 75,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "지우개 좀 빌려줄래?",
"key": "vf7eab016"
},
{
"no": 76,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "지우개 내놔.",
"key": "vbca82425"
},
{
"no": 77,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "(말없이 가져가기)",
"key": "vf2babc6c"
},
{
"no": 78,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "안녕히 계세요.",
"key": "vd97556c4"
},
{
"no": 79,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "고마워! 다 쓰고 돌려줄게.",
"key": "v9a5a07cc"
},
{
"no": 80,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "(그냥 가기)",
"key": "v0c429a73"
},
{
"no": 81,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "이거 내 거야.",
"key": "vc9f130ef"
},
{
"no": 82,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "안녕하세요!",
"key": "v61a66175"
},
{
"no": 83,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "안녕하세요, 선생님!",
"key": "v1f7c6696"
},
{
"no": 84,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "안녕!",
"key": "vef279e65"
},
{
"no": 85,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "나 (학생 대답)",
"text": "(그냥 지나가기)",
"key": "v20d40e8b"
},
{
"no": 86,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "선생님",
"text": "오늘은 학급 문구 장터가 열려. 학급 토큰으로 준비물을 살 수 있단다.",
"key": "vf6d23060"
},
{
"no": 87,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "선생님",
"text": "오늘은 체육 시간이야. 이건 대여카드야. 체육 도구를 빌릴 때 대여 창구에 보여 주는 카드란다.",
"key": "vfb619148"
},
{
"no": 88,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "선생님",
"text": "오늘은 운동회야! 먹거리 부스에서 친구들 간식을 사 와 줄래?",
"key": "v672befb6"
},
{
"no": 89,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "선생님",
"text": "하나 더 부탁할게.",
"key": "vcf9db7fe"
},
{
"no": 90,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "선생님",
"text": "앗, 지우개가 없구나. 짝꿍에게 빌려 볼까?",
"key": "v247a7585"
},
{
"no": 91,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "선생님",
"text": "안녕! 오늘도 즐겁게 지내자.",
"key": "v31b060be"
},
{
"no": 92,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "선생님",
"text": "반납까지 잘했어!",
"key": "v78acd629"
},
{
"no": 93,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "선생님",
"text": "오늘 정말 잘했어! 은행에 들렀다가 집에 가렴.",
"key": "v41d1997b"
},
{
"no": 94,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "안내 (내레이션)",
"text": "대여카드를 받았어요.",
"key": "v4a825618"
},
{
"no": 95,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "안내 (내레이션)",
"text": "짝꿍에게 뭐라고 말할까요?",
"key": "v5805ca86"
},
{
"no": 96,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "안내 (내레이션)",
"text": "지우개를 받았어요. 뭐라고 말할까요?",
"key": "v1d85d8bb"
},
{
"no": 97,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "안내 (내레이션)",
"text": "선생님을 만났어요. 뭐라고 인사할까요?",
"key": "vaec9ddd5"
},
{
"no": 98,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "엄마·선생님",
"text": "심부름 값으로 천 원 줄게!",
"key": "vc591e716"
},
{
"no": 99,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "엄마·선생님",
"text": "참 잘했어요! 칭찬 용돈 500원이야.",
"key": "v06019f03"
},
{
"no": 100,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "짝꿍",
"text": "그래, 여기 있어!",
"key": "v76ab247e"
},
{
"no": 101,
"cat": "3. 학교 (교실·체육관·운동장)",
"who": "짝꿍",
"text": "응!",
"key": "v05f37de7"
},
{
"no": 114,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "우리 가게 건 다 샀구나! 다른 가게에도 들러 보렴.",
"key": "v9dccf30c"
},
{
"no": 115,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "또 와!",
"key": "v6940d292"
},
{
"no": 116,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "이번에는 셀프 계산대에서 계산해 보세요.",
"key": "v82c46037"
},
{
"no": 117,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "먼저 카트를 가져와서 코너에서 물건을 담아 오세요.",
"key": "v2eb8fac7"
},
{
"no": 118,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "어서 와! 지금은 심부름이 없구나.",
"key": "vabe31d90"
},
{
"no": 119,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "안녕! 지금은 할 일이 없구나.",
"key": "va4cedcc1"
},
{
"no": 120,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "선생님께 가 보렴.",
"key": "v3435fa04"
},
{
"no": 121,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "어서 와! 문구 장터야.",
"key": "v5646accf"
},
{
"no": 122,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "어서 와!",
"key": "vf128199c"
},
{
"no": 123,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "미안해. 그건 다 떨어졌어. 다른 걸로 줄까?",
"key": "v58d4399e"
},
{
"no": 124,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "고마워! 그건 오늘은 빼고 줄게. 다른 건 있어.",
"key": "v268461be"
},
{
"no": 125,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "바코드를 찍을게요. 삑, 삑!",
"key": "v34374b29"
},
{
"no": 126,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "어머, 그건 유통기한이 지났어요. 날짜를 다시 확인해 볼까요?",
"key": "v2c8fc276"
},
{
"no": 127,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "기다려 줘서 고마워. 이제 앉아 볼까? 어떻게 해 줄까?",
"key": "v22105d2f"
},
{
"no": 128,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "다 됐어! 정말 잘 참았구나.",
"key": "v6915877b"
},
{
"no": 129,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "모두 얼마인지 알겠니?",
"key": "ve81e5b80"
},
{
"no": 130,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "카드 가져가야지!",
"key": "v83a16c70"
},
{
"no": 131,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "이건 덤이야! 하나 더 넣었어.",
"key": "vabcaaa9d"
},
{
"no": 132,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "자, 여기 있어!",
"key": "v3482af90"
},
{
"no": 133,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "고마워! 또 와!",
"key": "v080aba2d"
},
{
"no": 134,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "음, 빌려 간 것과 달라. 다시 생각해 볼래?",
"key": "vd5ce3de3"
},
{
"no": 135,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "어, 메모에 적힌 거 맞니? 다시 골라 볼래?",
"key": "v2bdf6424"
},
{
"no": 136,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "골라 줘.",
"key": "v2a2d463d"
},
{
"no": 137,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "배고파 보이네. 먹고 갈래?",
"key": "v11877945"
},
{
"no": 138,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "미안해요, 우리 가게는 현금만 받아요. 현금으로 내 줄래요?",
"key": "vd4e0d36f"
},
{
"no": 139,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "돈은 이미 다 냈어!",
"key": "v3420d3f0"
},
{
"no": 140,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "돈이 너무 많아. 그림자랑 똑같이 맞춰 볼까?",
"key": "v082926ef"
},
{
"no": 141,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "여기 거스름돈!",
"key": "v0bacd666"
},
{
"no": 142,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "다시 세어 볼래?",
"key": "vd4a42036"
},
{
"no": 143,
"cat": "4. 가게 계산대",
"who": "가게 사람",
"text": "어머, 미안해! 여기 있어.",
"key": "v06000540"
},
{
"no": 144,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "줄 서서 기다려요",
"key": "vd8dbf70f"
},
{
"no": 145,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "앞으로 끼어들어요",
"key": "v47d4286d"
},
{
"no": 146,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "큰 소리로 불러요",
"key": "v7e82761b"
},
{
"no": 147,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "괜찮아요. 그럼 다른 날 살게요.",
"key": "v2397f8ab"
},
{
"no": 148,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "왜 없어요! 빨리 줘요!",
"key": "v2b497307"
},
{
"no": 149,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "(화내고 나가기)",
"key": "vaad408ec"
},
{
"no": 150,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "의자에 앉아서 기다려요",
"key": "v6428e9b0"
},
{
"no": 151,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "계속 빨리 해 달라고 해요",
"key": "v212b7b3a"
},
{
"no": 152,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "그냥 나가요",
"key": "v2f17ed0a"
},
{
"no": 153,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "아무렇게나 해 주세요.",
"key": "v6c6833b8"
},
{
"no": 154,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "감사합니다!",
"key": "v5def7d3f"
},
{
"no": 155,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "(그냥 받기)",
"key": "v5aa1bf46"
},
{
"no": 156,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "더 주세요.",
"key": "va5899c97"
},
{
"no": 157,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "괜찮아요. 장바구니 있어요.",
"key": "vb688ad4e"
},
{
"no": 158,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "(대답 안 하기)",
"key": "v8abeab8b"
},
{
"no": 159,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "봉투 내놔요.",
"key": "vf028f416"
},
{
"no": 160,
"cat": "4. 가게 계산대",
"who": "나 (학생 대답)",
"text": "몰라요.",
"key": "vc583b68b"
},
{
"no": 161,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "다 끝났어요. 떠날 때는 뭐라고 할까요?",
"key": "v511b28e3"
},
{
"no": 162,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "앞에 다른 손님이 계산하고 있어요. 어떻게 할까요?",
"key": "v515f4a0d"
},
{
"no": 163,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "차례를 잘 기다렸어요!",
"key": "v8e9e6b02"
},
{
"no": 164,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "어떻게 말할까요?",
"key": "v8f826ff1"
},
{
"no": 165,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "잠깐 기다려 달래요. 어떻게 할까요?",
"key": "vb06526ef"
},
{
"no": 166,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "메모를 떠올려 봐요. 미용사 선생님께 뭐라고 할까요?",
"key": "v197c42c4"
},
{
"no": 167,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "결제가 끝났어요. 이제 무엇을 할까요?",
"key": "vfc34806a"
},
{
"no": 168,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "덤을 받았어요. 뭐라고 할까요?",
"key": "v225518cf"
},
{
"no": 169,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "봉투 필요하세요?",
"key": "v4619c779"
},
{
"no": 170,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "무엇을 빌렸었는지 기억해서 골라요.",
"key": "v322d04fb"
},
{
"no": 171,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "뭐 줄까?",
"key": "vf388839e"
},
{
"no": 172,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "반납할 도구를 모두 골라요",
"key": "vb3108a06"
},
{
"no": 173,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "빌릴 도구를 골라요",
"key": "vc0dc3901"
},
{
"no": 174,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "이번에는 체크카드로 내 볼까?",
"key": "v5ecb3e88"
},
{
"no": 175,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "계좌에 돈이 모자라요. 체크카드는 계좌에 있는 돈만 쓸 수 있어요.",
"key": "v08e03e8f"
},
{
"no": 176,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "결제가 끝났어요.",
"key": "v7399927a"
},
{
"no": 177,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "거스름돈은 얼마일까요?",
"key": "vf8f166d0"
},
{
"no": 178,
"cat": "4. 가게 계산대",
"who": "안내 (내레이션)",
"text": "받은 거스름돈을 세어 봐요. 맞나요?",
"key": "v220fcc97"
},
